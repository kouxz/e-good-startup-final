<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.E_goodApp">

        <!-- Configurada como a primeira tela do app -->
        <activity
            android:name=".views.user.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela de Cadastro (Seletor de tipo) -->
        <activity
            android:name=".views.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de Cadastro de Pessoa -->
        <activity
            android:name=".views.user.UserRegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de Cadastro de Concessionária -->
        <activity
            android:name=".views.dealer.DealerRegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela Dashboard de Concessionária -->
        <activity
            android:name=".views.dealer.DealerDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela inicial do usuário -->
        <activity
            android:name=".views.user.HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de Comparação -->
        <activity
            android:name=".views.comparison.ComparisonActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de Solar -->
        <activity
            android:name=".views.vehicle.SolarActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de Perfil -->
        <activity
            android:name=".views.user.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de Veículos -->
        <activity
            android:name=".views.vehicle.VehiclesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de Detalhes do Veículo -->
        <activity
            android:name=".views.vehicle.VehicleDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de Concessionárias -->
        <activity
            android:name=".views.dealership.ConcessionariasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de Detalhes da Concessionária -->
        <activity
            android:name=".views.dealership.ConcessionariaDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela de Adicionar Veículo -->
        <activity
            android:name=".views.dealer.AddVehicleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Demais telas do app -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>