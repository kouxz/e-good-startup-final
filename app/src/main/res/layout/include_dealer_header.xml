<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/dealerHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@color/app_surface">
 <ImageView android:layout_width="28dp" android:layout_height="28dp" app:srcCompat="@drawable/ic_egood_logo" android:importantForAccessibility="no" />
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="e-good" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/app_text_primary" />
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="BUSINESS" android:textSize="8sp" android:textColor="#008B7A" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/bg_dealer_business" />
 <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
 <ImageView android:id="@+id/btnNotifications" android:layout_width="40dp" android:layout_height="48dp" android:padding="10dp" app:srcCompat="@drawable/ic_add_vehicle_notifications" app:tint="@color/app_text_secondary" android:contentDescription="Notificações" />
 <FrameLayout android:id="@+id/btnMenuHamburger" android:layout_width="48dp" android:layout_height="48dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless" android:contentDescription="Abrir menu da concessionária">
  <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:padding="8dp" android:background="@drawable/bg_dealer_menu" app:srcCompat="@drawable/ic_add_vehicle_menu" app:tint="@color/app_text_secondary" android:importantForAccessibility="no" />
 </FrameLayout>
</LinearLayout>
