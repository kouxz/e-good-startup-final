<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#EDF0F3"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="#0D9488"
                android:id="@+id/tvInterestAvatar"
                android:gravity="center"
                android:background="@drawable/bg_badge_teal"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:id="@+id/tvInterestName"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:id="@+id/tvInterestVehicle"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novo"
                android:textSize="10sp"
                android:textColor="#0891B2"
                android:id="@+id/tvInterestStatus"
                android:minHeight="48dp"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_badge_teal" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#64748B"
            android:id="@+id/tvInterestPhone"
            android:layout_marginTop="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:id="@+id/tvInterestDate"
            android:layout_marginTop="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:id="@+id/btnInterestWhatsApp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="WhatsApp"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#0D9488"
                app:backgroundTint="#E0F8F7"
                app:cornerRadius="12dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_marginEnd="4dp"
                android:enabled="false"
                android:alpha="0.4" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:id="@+id/btnInterestCall"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="Ligar"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#475569"
                app:backgroundTint="#F1F3F5"
                app:cornerRadius="12dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_marginEnd="4dp" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:id="@+id/btnInterestEmail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="E-mail"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#475569"
                app:backgroundTint="#F1F3F5"
                app:cornerRadius="12dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_marginEnd="4dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
