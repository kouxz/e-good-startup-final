<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/app_surface"
    app:strokeColor="@color/app_stroke"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/app_teal_content"
                android:id="@+id/tvInterestAvatar"
                android:gravity="center"
                android:background="@drawable/bg_badge_teal"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/app_text_primary"
                    android:id="@+id/tvInterestName"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/app_text_muted"
                    android:id="@+id/tvInterestVehicle"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novo"
                android:textSize="10sp"
                android:textColor="#0891B2"
                android:id="@+id/tvInterestStatus"
                android:minHeight="48dp"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/bg_badge_teal" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/app_text_secondary"
            android:id="@+id/tvInterestPhone"
            android:layout_marginTop="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/app_text_muted"
            android:id="@+id/tvInterestDate"
            android:layout_marginTop="4dp" />
        <TextView
            android:id="@+id/tvInterestOutcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_teal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/contact_sale_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:id="@+id/btnInterestCall"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="Ligar"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="@color/app_text_secondary"
                app:backgroundTint="@color/app_surface_variant"
                app:cornerRadius="12dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_marginEnd="4dp"
                app:icon="@drawable/ic_profile_phone"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/app_icon_neutral" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:id="@+id/btnInterestEmail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="E-mail"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="@color/app_text_secondary"
                app:backgroundTint="@color/app_surface_variant"
                app:cornerRadius="12dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_marginStart="4dp"
                app:icon="@drawable/ic_login_email"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/app_icon_neutral" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btnInterestStatusAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="Atualizar andamento"
            android:textAllCaps="false"
            android:textColor="@color/app_teal_content"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_dealer_chevron"
            app:iconGravity="textEnd"
            app:iconSize="18dp"
            app:iconTint="@color/app_teal_content"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
