<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true"
    android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="14dp" app:cardElevation="1dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_user_icon_tile" android:padding="10dp" android:contentDescription="Concessionária" app:srcCompat="@drawable/ic_user_dealership" app:tint="#008B7A" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/homeDealerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/homeDealerMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#64748B" android:textSize="11sp" />
            <TextView android:id="@+id/homeDealerStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#008B7A" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:padding="5dp" android:contentDescription="Abrir concessionária" app:srcCompat="@drawable/ic_dealer_chevron" app:tint="#94A3B8" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
