<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFA"
    android:fitsSystemWindows="true">

    <include layout="@layout/include_user_header" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/userHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView
                    android:id="@+id/tvTitleComparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comparação Detalhada"
                    android:textSize="20sp"
                    android:textColor="#0F172A"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvSubtitleComparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Escolha dois veículos para comparar"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/comparisonTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_simulation_tabs"
                android:padding="3dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/tabComparacao">
                <com.google.android.material.button.MaterialButton android:id="@+id/tabComparacao" style="@style/Simulation.Tab" android:text="Comparação"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/tabCalculadora" style="@style/Simulation.Tab" android:text="Calculadora"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/containerComparacao"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Baseado em 15.000 km/ano"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:layout_marginBottom="14dp"/>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#99DEDA">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚡  Veículo Elétrico"
                            android:textSize="14sp"
                            android:textColor="#0F172A"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Selecione o modelo"
                            android:textSize="11sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"/>
                        <Spinner
                            android:id="@+id/spEvComparacao"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:spinnerMode="dropdown"
                            android:background="@drawable/bg_simulation_input"
                            android:popupBackground="#FFFFFF"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Consumo"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvConsumEvComparacao"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F172A"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Custo anual de energia"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvCostEvComparacao"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F766E"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Preço do veículo"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvPriceEvComparacao"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F172A"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VS"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#FED7AA">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="♧  Veículo a Combustão"
                            android:textSize="14sp"
                            android:textColor="#0F172A"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Selecione o modelo"
                            android:textSize="11sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"/>
                        <Spinner
                            android:id="@+id/spCombComparacao"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:spinnerMode="dropdown"
                            android:background="@drawable/bg_simulation_input"
                            android:popupBackground="#FFFFFF"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Consumo"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvConsumCombComparacao"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F172A"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Custo anual de combustível"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvCostCombComparacao"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#C2410C"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Preço do veículo"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvPriceCombComparacao"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F172A"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_simulation_gradient"
                    android:padding="20dp"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="$"
                        android:textSize="25sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>
                    <TextView
                        android:id="@+id/tvAnnualSavingsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Economia anual estimada com o elétrico"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>
                    <TextView
                        android:id="@+id/tvAnnualSavings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="28sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gasolina: R$ 5,79/L · Energia: R$ 0,85/kWh"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#99DEDA">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💡 Dica"
                            android:textSize="14sp"
                            android:textColor="#0F172A"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Use a Calculadora para ajustar os preços de energia e gasolina e simular seus gastos mensais."
                            android:textSize="12sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/containerCalculadora"
                android:visibility="gone"
                android:padding="16dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#99DEDA">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚡  Veículo Elétrico"
                            android:textSize="14sp"
                            android:textColor="#0F172A"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Selecione o modelo"
                            android:textSize="11sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"/>
                        <Spinner
                            android:id="@+id/spEvCalculadora"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:spinnerMode="dropdown"
                            android:background="@drawable/bg_simulation_input"
                            android:popupBackground="#FFFFFF"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Consumo"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvConsumEvCalc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F172A"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Preço do veículo"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvPriceEvCalc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F172A"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tarifa de energia (R$/kWh)"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvEnergyCostValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F766E"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderEnergyCost" style="@style/Widget.MaterialComponents.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:contentDescription="Tarifa de energia (R$/kWh)"
                            android:valueFrom=".4"
                            android:valueTo="2"
                            android:value=".85"
                            android:stepSize=".01"
                            app:labelBehavior="gone"
                            app:thumbColor="#0D9488"
                            app:trackColorActive="#0D9488"
                            app:trackColorInactive="#CBD5E1"
                            app:tickVisible="false"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="R$ 0,40"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R$ 2,00"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#FED7AA">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="♧  Veículo a Combustão"
                            android:textSize="14sp"
                            android:textColor="#0F172A"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Selecione o modelo"
                            android:textSize="11sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"/>
                        <Spinner
                            android:id="@+id/spCombCalculadora"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:spinnerMode="dropdown"
                            android:background="@drawable/bg_simulation_input"
                            android:popupBackground="#FFFFFF"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Consumo"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvConsumCombCalc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F172A"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Preço do veículo"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvPriceCombCalc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F172A"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Gasolina (R$/L)"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvGasCostValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#C2410C"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderGasCost" style="@style/Widget.MaterialComponents.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:contentDescription="Gasolina (R$/L)"
                            android:valueFrom="4"
                            android:valueTo="9"
                            android:value="5.79"
                            android:stepSize=".01"
                            app:labelBehavior="gone"
                            app:thumbColor="#EA580C"
                            app:trackColorActive="#EA580C"
                            app:trackColorInactive="#CBD5E1"
                            app:tickVisible="false"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="R$ 4,00"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R$ 9,00"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Quilômetros por mês"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvMonthlyKmValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F766E"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderMonthlyKm" style="@style/Widget.MaterialComponents.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:contentDescription="Quilômetros por mês"
                            android:valueFrom="500"
                            android:valueTo="5000"
                            android:value="1500"
                            android:stepSize="50"
                            app:labelBehavior="gone"
                            app:thumbColor="#0D9488"
                            app:trackColorActive="#0D9488"
                            app:trackColorInactive="#CBD5E1"
                            app:tickVisible="false"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="500 km"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5.000 km"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Custo mensal elétrico"
                                android:textSize="11sp"
                                android:textColor="#64748B"
                                android:gravity="center"/>
                            <TextView
                                android:id="@+id/tvCostEvCalc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="#0F766E"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#0F766E"
                        app:strokeWidth="1dp"
                        app:strokeColor="#0D9488">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/tvMonthlySavingsLabel"
                                android:text="Economia mensal"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"/>
                            <TextView
                                android:id="@+id/tvMonthlySavings"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                            <TextView
                                android:id="@+id/tvSavingsPercent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="10sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Custo mensal combustível"
                                android:textSize="11sp"
                                android:textColor="#64748B"
                                android:gravity="center"/>
                            <TextView
                                android:id="@+id/tvCostCombCalc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="#C2410C"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:id="@+id/tvAnnualSavingsCalcLabel"
                                android:text="Economia anual estimada"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvAnnualSavingsCalc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F766E"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <include layout="@layout/include_user_bottom_nav" />
</androidx.constraintlayout.widget.ConstraintLayout>
