<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
    <TextView android:id="@+id/passwordRuleLength" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:tag="Entre 8 e 30 caracteres" android:text="Entre 8 e 30 caracteres" android:textSize="12sp" android:textColor="@color/app_text_secondary" />
    <TextView android:id="@+id/passwordRuleUpper" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:tag="Uma letra maiúscula (A–Z)" android:text="Uma letra maiúscula (A–Z)" android:textSize="12sp" android:textColor="@color/app_text_secondary" />
    <TextView android:id="@+id/passwordRuleLower" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:tag="Uma letra minúscula (a–z)" android:text="Uma letra minúscula (a–z)" android:textSize="12sp" android:textColor="@color/app_text_secondary" />
    <TextView android:id="@+id/passwordRuleDigit" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:tag="Um número (0–9)" android:text="Um número (0–9)" android:textSize="12sp" android:textColor="@color/app_text_secondary" />
    <TextView android:id="@+id/passwordRuleSpecial" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:tag="Um símbolo, por exemplo !, @, # ou _" android:text="Um símbolo, por exemplo !, @, # ou _" android:textSize="12sp" android:textColor="@color/app_text_secondary" />
</LinearLayout>
