<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="@color/app_surface">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnChatBack" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/chat_back"
            android:insetTop="0dp" android:insetBottom="0dp" android:padding="12dp" android:minWidth="48dp"
            app:icon="@drawable/ic_vehicle_back" app:iconTint="@color/app_teal_content" app:iconPadding="0dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="8dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_title"
                android:textColor="@color/app_text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_subtitle"
                android:textColor="@color/app_text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChat" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="12dp" android:paddingVertical="12dp"
        android:scrollbars="vertical" android:saveEnabled="false" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/chatSuggestCompare" style="@style/Widget.EGood.ChatSuggestion" android:text="@string/chat_compare" />
            <com.google.android.material.button.MaterialButton android:id="@+id/chatSuggestCustom" style="@style/Widget.EGood.ChatSuggestion" android:layout_marginStart="8dp" android:text="@string/chat_custom" />
            <com.google.android.material.button.MaterialButton android:id="@+id/chatSuggestSolar" style="@style/Widget.EGood.ChatSuggestion" android:layout_marginStart="8dp" android:text="@string/chat_solar" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="12dp" android:background="@color/app_surface">
        <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:hint="@string/chat_hint"
            app:boxBackgroundColor="@color/app_surface_variant" app:boxStrokeColor="@color/login_input_stroke"
            app:hintTextColor="@color/app_teal_content" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp" android:maxLines="3" android:maxLength="500" android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="actionSend" android:saveEnabled="false" android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_secondary" android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSend" android:layout_width="52dp" android:layout_height="52dp"
            android:layout_marginStart="8dp" android:minWidth="52dp" android:padding="14dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:contentDescription="@string/chat_send" app:cornerRadius="12dp" app:backgroundTint="@color/register_primary_button_background"
            app:icon="@drawable/ic_chat_send" app:iconTint="@color/chat_on_primary" app:iconPadding="0dp" />
    </LinearLayout>
</LinearLayout>
