<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background_app">
    <include layout="@layout/include_dealer_header" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="36dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adicionar Veículo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preencha os dados do veículo elétrico"
                android:textSize="13sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_badge_teal"
                android:padding="12dp"
                android:layout_marginBottom="20dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:srcCompat="@drawable/ic_add_vehicle_bolt"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="12dp"
                    android:padding="6dp"
                    android:background="@drawable/bg_badge" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Somente veículos elétricos"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BEV ou PHEV com autonomia mínima de 80 km"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/Widget.EGood.AddVehicle.Label"
                    android:text="MARCA"
                    android:labelFor="@id/editMarca" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                        android:id="@+id/editMarca"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Ex: BYD, Volvo, Mercedes..."
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/Widget.EGood.AddVehicle.Label"
                    android:text="MODELO"
                    android:labelFor="@id/editModelo" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                        android:id="@+id/editModelo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Ex: Dolphin Mini, EX30..."
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">
                    <TextView style="@style/Widget.EGood.AddVehicle.Label"
                        android:text="ANO"
                        android:labelFor="@id/editAno" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                            android:id="@+id/editAno"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="Ex: 2024"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView style="@style/Widget.EGood.AddVehicle.Label"
                        android:text="QUILOMETRAGEM"
                        android:labelFor="@id/editQuilometragem" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                            android:id="@+id/editQuilometragem"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="Ex: 0"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/Widget.EGood.AddVehicle.Label"
                    android:text="PREÇO (R$)"
                    android:labelFor="@id/editPreco" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                        android:id="@+id/editPreco"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Ex: 119800"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/Widget.EGood.AddVehicle.Label"
                    android:text="CATEGORIA"
                    android:labelFor="@id/spinnerCategoria" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="#0F172A"
                    app:endIconContentDescription="Escolher categoria">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView style="@style/Widget.EGood.AddVehicle.Input"
                        android:id="@+id/spinnerCategoria"
                        android:freezesText="true"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Selecione a categoria"
                        android:inputType="none"
                        android:cursorVisible="false"
                        android:textColor="#0F172A"
                        android:popupBackground="@color/surface_white"
                        app:simpleItemLayout="@layout/item_add_vehicle_category" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">
                    <TextView style="@style/Widget.EGood.AddVehicle.Label"
                        android:text="BATERIA (KWH)"
                        android:labelFor="@id/editBateria" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                            android:id="@+id/editBateria"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="Ex: 60"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView style="@style/Widget.EGood.AddVehicle.Label"
                        android:text="AUTONOMIA (KM)"
                        android:labelFor="@id/editAutonomia" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                            android:id="@+id/editAutonomia"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="Ex: 450"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="vertical">
                    <TextView style="@style/Widget.EGood.AddVehicle.Label" android:text="CONSUMO (KWH/100 KM)" android:labelFor="@id/editConsumo" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                            android:id="@+id/editConsumo" android:layout_width="match_parent" android:layout_height="48dp"
                            android:hint="Ex: 12,9" android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Widget.EGood.AddVehicle.Label" android:text="POTÊNCIA (CV)" android:labelFor="@id/editPotencia" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                            android:id="@+id/editPotencia" android:layout_width="match_parent" android:layout_height="48dp"
                            android:hint="Ex: 204" android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Widget.EGood.AddVehicle.Label" android:text="RECARGA" android:labelFor="@id/editRecarga" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                        android:id="@+id/editRecarga" android:layout_width="match_parent" android:layout_height="48dp"
                        android:hint="Ex: AC 11 kW / DC 80 kW" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/Widget.EGood.AddVehicle.Label"
                    android:text="COR"
                    android:labelFor="@id/editCor" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                        android:id="@+id/editCor"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Ex: Branco Pérola"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/Widget.EGood.AddVehicle.Label"
                    android:text="DESCRIÇÃO"
                    android:labelFor="@id/editDescricao" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.EGood.AddVehicle.InputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText style="@style/Widget.EGood.AddVehicle.Input"
                        android:id="@+id/editDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:hint="Descreva os diferenciais do veículo..."
                        android:inputType="textMultiLine"
                        android:singleLine="false"
                        android:gravity="top|start"
                        android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/photoUploadContainer"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_add_vehicle_photos"
                android:layout_marginBottom="16dp"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/previewImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/photoUploadPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:srcCompat="@android:drawable/ic_menu_camera"
                        android:scaleType="centerInside"
                        app:tint="#0F172A" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adicionar fotos"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toque para selecionar até 10 imagens"
                        android:textSize="12sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </FrameLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Publicar Veículo"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@null"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_gradient_teal" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/include_dealer_bottom_nav" />
</LinearLayout>
    <include layout="@layout/include_dealer_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
