<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="5dp">
    <com.google.android.material.card.MaterialCardView android:id="@+id/containerUser" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:layout_marginStart="32dp" app:cardBackgroundColor="@color/teal_light"
        app:cardCornerRadius="14dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/app_stroke">
        <TextView android:id="@+id/tvUserMessage" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="14dp" android:textColor="@color/app_text_primary" android:textSize="14sp" android:textIsSelectable="true" android:saveEnabled="false" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/containerBot" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="start" android:layout_marginEnd="24dp" app:cardBackgroundColor="@color/app_surface"
        app:cardCornerRadius="14dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/app_stroke">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/chat_bot_name"
                android:textColor="@color/app_teal_content" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="5dp" />
            <TextView android:id="@+id/tvBotMessage" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/app_text_primary" android:textSize="14sp" android:textIsSelectable="true" android:saveEnabled="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
