<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_white"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvVoltar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:text="Voltar"
            android:textAllCaps="false"
            android:textColor="@color/app_teal_content"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_register_back"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/app_teal_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:contentDescription="e-good"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvVoltar"
            app:srcCompat="@drawable/ic_egood_logo" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="2"
            android:text="Cadastro de concessionária"
            android:textColor="@color/app_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/ivLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivLogo"
            app:layout_constraintTop_toTopOf="@id/ivLogo" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cadastre sua empresa para publicar e gerenciar veículos"
            android:textColor="@color/app_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogo" />

        <LinearLayout
            android:id="@+id/formConcessionaria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <TextView
                style="@style/TextAppearance.EGood.Register.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Dados da empresa" />

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editNomeEmpresa"
                android:text="Nome da empresa" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:startIconDrawable="@drawable/ic_user_dealership">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editNomeEmpresa"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="organizationName"
                    android:hint="Nome da concessionária"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editCnpj"
                android:text="CNPJ" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:startIconDrawable="@drawable/ic_profile_document">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCnpj"
                    style="@style/Widget.EGood.Register.Input"
                    android:hint="00.000.000/0000-00"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="14" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editTelefone"
                android:text="Telefone" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                app:startIconDrawable="@drawable/ic_profile_phone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTelefone"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="phone"
                    android:hint="(11) 99999-9999"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:maxLength="11" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:background="@color/app_stroke" />

            <TextView
                style="@style/TextAppearance.EGood.Register.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Dados de acesso" />

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editEmailEmpresa"
                android:text="E-mail" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:startIconDrawable="@drawable/ic_login_email">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editEmailEmpresa"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="emailAddress"
                    android:hint="email@empresa.com"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editSenhaEmpresa"
                android:text="Senha" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutDealerPassword"
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:endIconContentDescription="Mostrar ou ocultar senha"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_login_lock">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editSenhaEmpresa"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="newPassword"
                    android:hint="••••••••"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/include_password_policy" />

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editConfSenhaEmpresa"
                android:text="Confirmar senha" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutDealerConfirmPassword"
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                app:endIconContentDescription="Mostrar ou ocultar confirmação da senha"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_login_lock">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editConfSenhaEmpresa"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="newPassword"
                    android:hint="••••••••"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:background="@color/app_stroke" />

            <TextView
                style="@style/TextAppearance.EGood.Register.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Localização" />

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editEndereco"
                android:text="Endereço" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:startIconDrawable="@drawable/ic_profile_location">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editEndereco"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="postalAddress"
                    android:hint="Rua, número e bairro"
                    android:imeOptions="actionNext"
                    android:inputType="textPostalAddress|textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editCidade"
                android:text="Cidade" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:startIconDrawable="@drawable/ic_profile_location">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCidade"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="addressLocality"
                    android:hint="Cidade"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/TextAppearance.EGood.Register.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/editEstado"
                        android:text="Estado" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.EGood.Register.InputLayout"
                        android:layout_marginTop="6dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editEstado"
                            style="@style/Widget.EGood.Register.Input"
                            android:autofillHints="addressRegion"
                            android:hint="UF"
                            android:imeOptions="actionNext"
                            android:inputType="textCapCharacters"
                            android:maxLength="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/TextAppearance.EGood.Register.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/editCep"
                        android:text="CEP" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.EGood.Register.InputLayout"
                        android:layout_marginTop="6dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCep"
                            style="@style/Widget.EGood.Register.Input"
                            android:autofillHints="postalCode"
                            android:hint="00000-000"
                            android:imeOptions="actionDone"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/locationConcessionariaContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/formConcessionaria">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoLocationConcessionaria"
                style="@style/Widget.EGood.Register.LocationButton"
                android:layout_width="match_parent"
                android:text="Usar GPS"
                app:icon="@drawable/ic_profile_location" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualLocationConcessionaria"
                style="@style/Widget.EGood.Register.LocationButton.Outlined"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="Preencher manualmente"
                app:icon="@drawable/ic_profile_document" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCadastrar"
            style="@style/Widget.EGood.Register.PrimaryButton"
            android:layout_marginTop="24dp"
            android:text="Cadastrar concessionária"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/locationConcessionariaContainer" />

        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="Já tem uma conta? Entre aqui"
            android:textColor="@color/app_teal_content"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCadastrar" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
