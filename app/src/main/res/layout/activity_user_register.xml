<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_white"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvVoltar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:text="Voltar"
            android:textAllCaps="false"
            android:textColor="@color/app_teal_content"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_register_back"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/app_teal_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:contentDescription="e-good"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvVoltar"
            app:srcCompat="@drawable/ic_egood_logo" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:text="Criar sua conta"
            android:textColor="@color/app_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/ivLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivLogo"
            app:layout_constraintTop_toTopOf="@id/ivLogo" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Preencha seus dados para acessar veículos e concessionárias"
            android:textColor="@color/app_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogo" />

        <LinearLayout
            android:id="@+id/formPessoa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editNome"
                android:text="Nome completo" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:startIconDrawable="@drawable/ic_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editNome"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="name"
                    android:hint="Seu nome completo"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editTelefoneUsuario"
                android:text="Telefone" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:startIconDrawable="@drawable/ic_profile_phone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTelefoneUsuario"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="phone"
                    android:hint="(11) 99999-9999"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:maxLength="11" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editEmail"
                android:text="E-mail" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:startIconDrawable="@drawable/ic_login_email">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editEmail"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="emailAddress"
                    android:hint="seu@email.com"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editSenha"
                android:text="Senha" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutUserPassword"
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:endIconContentDescription="Mostrar ou ocultar senha"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_login_lock">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editSenha"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="newPassword"
                    android:hint="••••••••"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/include_password_policy" />

            <TextView
                style="@style/TextAppearance.EGood.Register.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/editConfSenha"
                android:text="Confirmar senha" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutUserConfirmPassword"
                style="@style/Widget.EGood.Register.InputLayout"
                android:layout_marginTop="6dp"
                app:endIconContentDescription="Mostrar ou ocultar confirmação da senha"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_login_lock">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editConfSenha"
                    style="@style/Widget.EGood.Register.Input"
                    android:autofillHints="newPassword"
                    android:hint="••••••••"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCadastrar"
            style="@style/Widget.EGood.Register.PrimaryButton"
            android:layout_marginTop="24dp"
            android:text="Criar conta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/formPessoa" />

        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="Já tem uma conta? Entre aqui"
            android:textColor="@color/app_teal_content"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCadastrar" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
