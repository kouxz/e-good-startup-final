<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/inputDeleteAccountPassword"
    style="@style/Widget.EGood.Login.InputLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="8dp"
    app:startIconDrawable="@drawable/ic_login_lock"
    app:endIconMode="password_toggle"
    app:endIconContentDescription="Mostrar ou ocultar senha">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editDeleteAccountPassword"
        style="@style/Widget.EGood.Login.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="password"
        android:hint="Senha atual"
        android:imeOptions="actionDone"
        android:inputType="textPassword" />
</com.google.android.material.textfield.TextInputLayout>
