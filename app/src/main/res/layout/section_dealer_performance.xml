<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
    android:layout_marginTop="12dp" android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Visualizações nos veículos" android:textSize="12sp" android:textColor="#64748B" />
            <TextView android:id="@+id/tvDashboardViews" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="14sp" android:textStyle="bold" android:textColor="#0F172A" />
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressDashboardViews" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:max="10" android:progress="0"
            app:indicatorColor="#0D9488" app:trackColor="#E2E8F0" app:trackCornerRadius="3dp" app:trackThickness="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Contatos recebidos" android:textSize="12sp" android:textColor="#64748B" />
            <TextView android:id="@+id/tvDashboardMonthlyContacts" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="14sp" android:textStyle="bold" android:textColor="#0F172A" />
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressDashboardContacts" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:max="10" android:progress="0"
            app:indicatorColor="#0D9488" app:trackColor="#E2E8F0" app:trackCornerRadius="3dp" app:trackThickness="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Taxa de conversão" android:textSize="12sp" android:textColor="#64748B" />
            <TextView android:id="@+id/tvDashboardConversion" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0%" android:textSize="14sp" android:textStyle="bold" android:textColor="#0F172A" />
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressDashboardConversion" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:max="100" android:progress="0"
            app:indicatorColor="#0D9488" app:trackColor="#E2E8F0" app:trackCornerRadius="3dp" app:trackThickness="6dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
