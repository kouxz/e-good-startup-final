<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:text="Configurações"
            android:textColor="@color/app_text_primary" android:textSize="20sp" android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/app_surface" app:cardCornerRadius="14dp"
            app:cardElevation="1dp" app:strokeColor="@color/app_stroke" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="14dp"
                    android:text="NOTIFICAÇÕES" android:textColor="@color/app_text_secondary" android:textSize="10sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
                    android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
                    <ImageView style="@style/Widget.EGood.DealerSettingIcon" android:contentDescription="Notificações gerais"
                        app:srcCompat="@drawable/ic_add_vehicle_notifications" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notificações gerais"
                            android:textColor="@color/app_text_primary" android:textSize="13sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Preferência salva neste aparelho"
                            android:textColor="@color/app_text_muted" android:textSize="10sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchDealerNotifications"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Ativar notificações gerais"
                        app:thumbTint="@color/dealer_switch_thumb" app:trackTint="@color/dealer_switch_track" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/app_surface_variant" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
                    android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
                    <ImageView style="@style/Widget.EGood.DealerSettingIcon" android:contentDescription="Novos interessados"
                        app:srcCompat="@drawable/ic_dealer_contacts" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Novos interessados"
                            android:textColor="@color/app_text_primary" android:textSize="13sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avisar quando houver um novo contato"
                            android:textColor="@color/app_text_muted" android:textSize="10sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchDealerInterests"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Ativar avisos de novos interessados"
                        app:thumbTint="@color/dealer_switch_thumb" app:trackTint="@color/dealer_switch_track" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/app_surface" app:cardCornerRadius="14dp" app:cardElevation="1dp"
            app:strokeColor="@color/app_stroke" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="14dp"
                    android:text="APARÊNCIA" android:textColor="@color/app_text_secondary" android:textSize="10sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
                    android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
                    <ImageView style="@style/Widget.EGood.DealerSettingIcon" android:contentDescription="Modo escuro"
                        app:srcCompat="@drawable/ic_theme_dark" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modo escuro"
                            android:textColor="@color/app_text_primary" android:textSize="13sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aplicar em todo o aplicativo"
                            android:textColor="@color/app_text_muted" android:textSize="10sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchDealerDarkMode"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Ativar modo escuro"
                        app:thumbTint="@color/dealer_switch_thumb" app:trackTint="@color/dealer_switch_track" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/app_surface" app:cardCornerRadius="14dp" app:cardElevation="1dp"
            app:strokeColor="@color/app_stroke" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="14dp"
                    android:text="CONTA" android:textColor="@color/app_text_secondary" android:textSize="10sp" />
                <LinearLayout android:id="@+id/btnDealerChangePassword" style="@style/Widget.EGood.DealerSettingRow" android:contentDescription="Alterar senha">
                    <ImageView style="@style/Widget.EGood.DealerSettingIcon" android:contentDescription="@null" app:srcCompat="@drawable/ic_login_lock" />
                    <TextView style="@style/Widget.EGood.DealerSettingLabel" android:text="Alterar senha" />
                    <ImageView style="@style/Widget.EGood.DealerSettingChevron" android:contentDescription="@null" app:srcCompat="@drawable/ic_dealer_chevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/app_surface" app:cardCornerRadius="14dp" app:cardElevation="1dp"
            app:strokeColor="@color/app_stroke" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="14dp"
                    android:text="SUPORTE" android:textColor="@color/app_text_secondary" android:textSize="10sp" />
                <LinearLayout android:id="@+id/btnDealerHelp" style="@style/Widget.EGood.DealerSettingRow" android:contentDescription="Abrir Central de Ajuda">
                    <ImageView style="@style/Widget.EGood.DealerSettingIcon" android:contentDescription="@null" app:srcCompat="@drawable/ic_profile_help" />
                    <TextView style="@style/Widget.EGood.DealerSettingLabel" android:text="Central de Ajuda" />
                    <ImageView style="@style/Widget.EGood.DealerSettingChevron" android:contentDescription="@null" app:srcCompat="@drawable/ic_dealer_chevron" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/app_surface_variant" />
                <LinearLayout android:id="@+id/btnDealerContact" style="@style/Widget.EGood.DealerSettingRow" android:contentDescription="Fale Conosco">
                    <ImageView style="@style/Widget.EGood.DealerSettingIcon" android:contentDescription="@null" app:srcCompat="@drawable/ic_profile_message" />
                    <TextView style="@style/Widget.EGood.DealerSettingLabel" android:text="Fale Conosco" />
                    <ImageView style="@style/Widget.EGood.DealerSettingChevron" android:contentDescription="@null" app:srcCompat="@drawable/ic_dealer_chevron" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/app_surface_variant" />
                <LinearLayout android:id="@+id/btnDealerTerms" style="@style/Widget.EGood.DealerSettingRow" android:contentDescription="Abrir Termos de Uso">
                    <ImageView style="@style/Widget.EGood.DealerSettingIcon" android:contentDescription="@null" app:srcCompat="@drawable/ic_profile_document" />
                    <TextView style="@style/Widget.EGood.DealerSettingLabel" android:text="Termos de Uso" />
                    <ImageView style="@style/Widget.EGood.DealerSettingChevron" android:contentDescription="@null" app:srcCompat="@drawable/ic_dealer_chevron" />
                </LinearLayout>
<LinearLayout android:id="@+id/btnDealerPrivacy" style="@style/Widget.EGood.DealerSettingRow" android:contentDescription="Política de Privacidade">
                    <ImageView style="@style/Widget.EGood.DealerSettingIcon" android:contentDescription="@null" app:srcCompat="@drawable/ic_login_lock" app:tint="@color/app_teal_content" />
                    <TextView style="@style/Widget.EGood.DealerSettingLabel" android:text="Política de Privacidade" />
                    <ImageView style="@style/Widget.EGood.DealerSettingChevron" android:contentDescription="@null" app:srcCompat="@drawable/ic_dealer_chevron" />
                </LinearLayout>
<LinearLayout android:id="@+id/btnDealerLgpd" style="@style/Widget.EGood.DealerSettingRow" android:contentDescription="LGPD e seus direitos">
                    <ImageView style="@style/Widget.EGood.DealerSettingIcon" android:contentDescription="@null" app:srcCompat="@drawable/ic_login_lock" />
                    <TextView style="@style/Widget.EGood.DealerSettingLabel" android:text="LGPD e seus direitos" />
                    <ImageView style="@style/Widget.EGood.DealerSettingChevron" android:contentDescription="@null" app:srcCompat="@drawable/ic_dealer_chevron" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/app_surface_variant" />
                <LinearLayout android:id="@+id/btnDealerDevelopers" style="@style/Widget.EGood.DealerSettingRow" android:contentDescription="Ver desenvolvedores">
                    <ImageView style="@style/Widget.EGood.DealerSettingIcon" android:contentDescription="@null" app:srcCompat="@drawable/ic_profile_developers" />
                    <TextView style="@style/Widget.EGood.DealerSettingLabel" android:text="Desenvolvedores" />
                    <ImageView style="@style/Widget.EGood.DealerSettingChevron" android:contentDescription="@null" app:srcCompat="@drawable/ic_dealer_chevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingsLogout" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp"
            android:text="Sair" android:textAllCaps="false" android:textColor="@color/app_error_text" android:textSize="12sp"
            app:backgroundTint="@color/app_error_surface" app:cornerRadius="12dp" app:icon="@drawable/ic_dealer_logout" app:iconTint="@color/app_error_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDealerDeleteAccount"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Excluir conta"
            android:textAllCaps="false"
            android:textColor="@color/app_error_text"
            app:backgroundTint="@color/app_surface"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_delete_account"
            app:iconTint="@color/app_error_text"
            app:strokeColor="@color/app_error_text"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
