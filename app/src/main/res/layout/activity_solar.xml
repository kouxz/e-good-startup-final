<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFA"
    android:fitsSystemWindows="true">

    <include layout="@layout/include_user_header" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/userHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_simulation_gradient"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Energia Solar"
                    android:textSize="22sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Simule seu sistema fotovoltaico"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#0F766E"
                        app:strokeWidth="1dp"
                        app:strokeColor="#0D9488">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="10dp">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Geração mensal"
                                app:srcCompat="@drawable/ic_user_solar"
                                app:tint="#FFFFFF" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Geração/mês"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"/>
                            <TextView
                                android:id="@+id/tvMonthlyGenerationTop"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#0F766E"
                        app:strokeWidth="1dp"
                        app:strokeColor="#0D9488">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="10dp">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="CO₂ estimado"
                                app:srcCompat="@drawable/ic_user_leaf" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="CO₂ estimado/ano"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"/>
                            <TextView
                                android:id="@+id/tvCO2Top"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#0F766E"
                        app:strokeWidth="1dp"
                        app:strokeColor="#0D9488">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="10dp">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Retorno estimado"
                                app:srcCompat="@drawable/ic_user_savings" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Retorno"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"/>
                            <TextView
                                android:id="@+id/tvPaybackTop"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Simulador Solar"
                            android:textSize="14sp"
                            android:textColor="#0F172A"
                            android:textStyle="bold"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Potência do sistema"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvSystemPowerValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F766E"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSystemPower" style="@style/Widget.MaterialComponents.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:contentDescription="Potência do sistema"
                            android:valueFrom="1"
                            android:valueTo="20"
                            android:value="5"
                            android:stepSize=".1"
                            app:labelBehavior="gone"
                            app:thumbColor="#0D9488"
                            app:trackColorActive="#0D9488"
                            app:trackColorInactive="#CBD5E1"
                            app:tickVisible="false"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="1 kWp"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20 kWp"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Conta de luz mensal"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvLightCostValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F766E"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderLightCost" style="@style/Widget.MaterialComponents.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:contentDescription="Conta de luz mensal"
                            android:valueFrom="100"
                            android:valueTo="2000"
                            android:value="400"
                            android:stepSize="10"
                            app:labelBehavior="gone"
                            app:thumbColor="#0D9488"
                            app:trackColorActive="#0D9488"
                            app:trackColorInactive="#CBD5E1"
                            app:tickVisible="false"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="R$ 100"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R$ 2.000"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tarifa de energia (R$/kWh)"
                                android:textSize="12sp"
                                android:textColor="#64748B"/>
                            <TextView
                                android:id="@+id/tvSolarTariffValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="180dp"
                                android:gravity="end"
                                android:textSize="12sp"
                                android:textColor="#0F766E"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSolarTariff" style="@style/Widget.MaterialComponents.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:contentDescription="Tarifa de energia (R$/kWh)"
                            android:valueFrom=".4"
                            android:valueTo="2"
                            android:value=".85"
                            android:stepSize=".01"
                            app:labelBehavior="gone"
                            app:thumbColor="#0D9488"
                            app:trackColorActive="#0D9488"
                            app:trackColorInactive="#CBD5E1"
                            app:tickVisible="false"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="R$ 0,40"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="R$ 2,00"
                                android:textColor="#64748B"
                                android:textSize="10sp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvRoofEstimate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="11sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="12dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Geração mensal"
                                android:textSize="11sp"
                                android:textColor="#64748B"
                                android:gravity="center"/>
                            <TextView
                                android:id="@+id/tvMonthlyGeneration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="#0F766E"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                            <TextView
                                android:id="@+id/tvAnnualGeneration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="10sp"
                                android:textColor="#64748B"
                                android:gravity="center"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Economia mensal"
                                android:textSize="11sp"
                                android:textColor="#64748B"
                                android:gravity="center"/>
                            <TextView
                                android:id="@+id/tvMonthlySavings"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="#0F766E"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                            <TextView
                                android:id="@+id/tvAnnualSolarSavings"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="10sp"
                                android:textColor="#64748B"
                                android:gravity="center"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Investimento"
                                android:textSize="11sp"
                                android:textColor="#64748B"
                                android:gravity="center"/>
                            <TextView
                                android:id="@+id/tvInvestment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="#0F172A"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Retorno simples"
                                android:textSize="11sp"
                                android:textColor="#64748B"
                                android:gravity="center"/>
                            <TextView
                                android:id="@+id/tvPayback"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="#0F172A"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Premissas da estimativa"
                            android:textSize="14sp"
                            android:textColor="#0F172A"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Geração: 130 kWh/mês por kWp. Instalação: R$ 4.000/kWp. CO₂: fator ilustrativo de 0,075 kg/kWh. Painéis de 400 W e área aproximada de 6 m²/kWp."
                            android:textSize="12sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="8dp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="A geração varia conforme localização e instalação. A economia é limitada à conta mensal e não desconta cobranças fixas. O retorno é uma estimativa simples."
                            android:textSize="12sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <include layout="@layout/include_user_bottom_nav" />
</androidx.constraintlayout.widget.ConstraintLayout>
