<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.EGood.Login.InputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/login_input_background</item>
        <item name="boxStrokeColor">@color/login_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="startIconTint">@color/login_input_icon</item>
        <item name="endIconTint">@color/login_input_icon</item>
        <item name="hintTextColor">#64748B</item>
    </style>

    <style name="Widget.EGood.Login.Input" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:background">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textColorHint">#64748B</item>
        <item name="android:textColorHighlight">#CCFBF1</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
